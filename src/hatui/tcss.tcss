#cards {
  width: 1fr;
  height: 1fr;
  padding: 0 1;
}

.group-card {
  height: auto;
  border: round $primary;
  border-title-color: $text;
  border-title-style: bold;
  background: $surface;
  padding: 0 1;
}

.entity-row {
  width: 100%;
  height: 1;
}

.entity-row:hover {
  background: $boost;
}

.icon {
  width: 3;
  height: 1;
  content-align: left middle;
}

.name {
  width: 1fr;
  height: 1;
  text-wrap: nowrap;
  text-overflow: ellipsis;
}

.state {
  width: auto;
  max-width: 50%;
  height: 1;
  padding-left: 1;
  color: $text;
  text-wrap: nowrap;
  text-overflow: ellipsis;
}

.state-on {
}

.state-off {
  color: $foreground-muted
}

.state-unavailable {
  color: $foreground-muted
}

.state-idle {
  color: $foreground-muted
}

.state-button {
  color: $text-primary
}

#loading {
    width: 100%;
    height: 1fr;
    align: center middle;
}

#loading-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#loading LoadingIndicator {
    width: 100%;
    height: 1;
    color: $accent;
}

#loading-status {
    width: 100%;
    text-align: center;
    margin-top: 1;
    color: $text-muted;
    text-style: italic;
}

.camera {
  height: auto;
  width: 100%;
}

.camera .picture {
  height: auto;
  min-height: 3;
  content-align: center middle;
  text-align: center;
  color: $foreground-muted;
}

CameraScreen {
  align: center middle;
}

#camera-modal {
  width: 90%;
  height: 90%;
  border: round $primary;
  background: $surface;
}

#camera-modal .picture {
  height: 1fr;
}

EntityModal {
  align: center middle;
}

#more-info {
  width: 80%;
  max-width: 100;
  height: 80%;
  border: round $primary;
  background: $surface;
  padding: 0 2;
}

#more-info-title {
  height: 2;
  margin-top: 1;
  color: $accent;
}

#more-info-state {
  height: auto;
  min-height: 3;
  margin: 1 0;
  padding: 0 1;
  border: round $primary-darken-2;
  background: $boost;
  content-align: left middle;
}

#more-info-action {
  margin-bottom: 1;
}

#more-info-details {
  width: 100%;
}

#more-info-footer {
  height: auto;
  align: right middle;
}

.section {
  text-style: bold;
  color: $accent;
  margin-top: 1;
}

.control-row {
  height: 1;
  margin-bottom: 1;
}

.control-label {
  width: 14;
}

ClickBar {
  width: 1fr;
  height: 1;
}

#light-controls, #media-controls {
  height: auto;
}

#media-buttons {
  height: 3;
}

#media-buttons Button {
  min-width: 6;
  margin-right: 1;
}

#more-info-chart, #more-info-logbook, #weather-panel {
  height: auto;
  width: 100%;
}
